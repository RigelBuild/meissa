{
	"$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
	"release-type": "node",
	"separate-pull-requests": false,
	"include-component-in-tag": true,
	"tag-separator": "@",
	"bump-minor-pre-major": true,
	"packages": {
		"packages/design-ledger-gate": {
			"component": "design-ledger-gate",
			"package-name": "@rigelbuild/design-ledger-gate"
		},
		"packages/dl-claim": {
			"component": "dl-claim",
			"package-name": "@rigelbuild/dl-claim"
		},
		"packages/dl-list": {
			"component": "dl-list",
			"package-name": "@rigelbuild/dl-list"
		},
		"packages/dl-reconcile": {
			"component": "dl-reconcile",
			"package-name": "@rigelbuild/dl-reconcile"
		},
		"packages/biome-config": {
			"component": "biome-config",
			"package-name": "@rigelbuild/biome-config"
		},
		"packages/tsconfig": {
			"component": "tsconfig",
			"package-name": "@rigelbuild/tsconfig"
		},
		"packages/renovate-preflight": {
			"component": "renovate-preflight",
			"package-name": "@rigelbuild/renovate-preflight"
		},
		"packages/length-gate": {
			"component": "length-gate",
			"package-name": "@rigelbuild/length-gate"
		},
		"go": {
			"release-type": "go",
			"component": "go",
			"tag-separator": "/",
			"initial-version": "0.1.0"
		}
	},
	"plugins": ["node-workspace"]
}
