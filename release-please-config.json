{
	"$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
	"release-type": "node",
	"separate-pull-requests": false,
	"include-component-in-tag": true,
	"tag-separator": "@",
	"bump-minor-pre-major": true,
	"packages": {
		"packages/ref-gate": {
			"component": "ref-gate",
			"package-name": "@rigelbuild/ref-gate"
		},
		"packages/design-ledger-gate": {
			"component": "design-ledger-gate",
			"package-name": "@rigelbuild/design-ledger-gate"
		},
		"packages/dl-claim": {
			"component": "dl-claim",
			"package-name": "@rigelbuild/dl-claim"
		},
		"packages/dl-reconcile": {
			"component": "dl-reconcile",
			"package-name": "@rigelbuild/dl-reconcile"
		},
		"packages/renovate-preflight": {
			"component": "renovate-preflight",
			"package-name": "@rigelbuild/renovate-preflight"
		}
	},
	"plugins": ["node-workspace"]
}
