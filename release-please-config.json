{
	"$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
	"release-type": "node",
	"separate-pull-requests": false,
	"include-component-in-tag": true,
	"tag-separator": "@",
	"bump-minor-pre-major": true,
	"packages": {
		"packages/biome-config": {
			"component": "biome-config",
			"package-name": "@rigelbuild/biome-config"
		},
		"packages/tsconfig": {
			"component": "tsconfig",
			"package-name": "@rigelbuild/tsconfig"
		},
		"packages/renovate-preflight": {
			"component": "renovate-preflight",
			"package-name": "@rigelbuild/renovate-preflight"
		},
		"packages/docs-bundle": {
			"component": "docs-bundle",
			"package-name": "@rigelbuild/docs-bundle"
		},
		"go": {
			"release-type": "go",
			"component": "go",
			"tag-separator": "/",
			"initial-version": "0.1.0"
		}
	},
	"plugins": ["node-workspace"]
}
