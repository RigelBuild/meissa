// Git hooks managed by hk (https://hk.jdx.dev).
amends "package://github.com/jdx/hk/releases/download/v2.11.1/hk@2.11.1#/Config.pkl"

default_branch = "main"

hooks {
    ["pre-push"] {
        steps {
            ["ci"] = new Step {
                check = "moon run :ci"
            }
        }
    }
}
