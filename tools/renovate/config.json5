{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  // No Renovate schedule: the workflow's daily cron is the cadence, so a late
  // GitHub cron start still opens PRs.
  extends: ["github>RigelBuild/meissa//tools/renovate/preset.json5"],
  enabledManagers: ["custom.regex", "bun", "npm"],
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: ["/^devenv\\.lock$/"],
      matchStrings: [
        "\"repo\": \"devenv-nixpkgs\",\\s*\"rev\": \"(?<currentDigest>[a-f0-9]{40})\"",
      ],
      depNameTemplate: "cachix/devenv-nixpkgs",
      packageNameTemplate: "https://github.com/cachix/devenv-nixpkgs",
      currentValueTemplate: "rolling",
      datasourceTemplate: "git-refs",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^tools/toolchain/go-analysis-pins\\.nix$/"],
      matchStrings: ["golangci-lint = \\{\\s*version = \"(?<currentValue>[^\"]+)\""],
      depNameTemplate: "golangci/golangci-lint",
      datasourceTemplate: "github-releases",
      extractVersionTemplate: "^v(?<version>.+)$",
      depTypeTemplate: "go-analysis",
    },
    {
      customType: "regex",
      managerFilePatterns: ["/^tools/toolchain/go-analysis-pins\\.nix$/"],
      matchStrings: ["rev = \"(?<currentDigest>[a-f0-9]{40})\""],
      depNameTemplate: "uber-go/nilaway",
      packageNameTemplate: "https://github.com/uber-go/nilaway",
      currentValueTemplate: "main",
      datasourceTemplate: "git-refs",
      depTypeTemplate: "go-analysis",
    },
  ],
  packageRules: [
    {
      // Mirrors bunfig.toml minimumReleaseAgeExcludes so Renovate and bun install agree;
      // config.test.ts keeps the two lists equal.
      matchPackageNames: ["@types/bun", "bun-types"],
      minimumReleaseAge: null,
    },
    {
      // TypeScript 7.0 ships without the programmatic API (it lands in 7.1), so
      // tools that import `typescript` break. Remove this cap once 7.1 ships.
      matchManagers: ["bun", "npm"],
      matchPackageNames: ["typescript"],
      allowedVersions: "<7",
    },
    {
      matchManagers: ["custom.regex"],
      matchDepNames: ["cachix/devenv-nixpkgs"],
      groupName: "devenv nixpkgs",
      minimumReleaseAge: null,
      postUpgradeTasks: {
        commands: ["devenv update nixpkgs", "nix flake update nixpkgs"],
        fileFilters: ["devenv.lock", "flake.lock"],
        executionMode: "branch",
      },
    },
    {
      matchManagers: ["custom.regex"],
      matchDepNames: ["uber-go/nilaway"],
      minimumReleaseAge: null,
    },
  ],
  postUpgradeTasks: {
    commands: ["bun tools/renovate/refresh-go-analysis-hashes.ts"],
    fileFilters: ["tools/toolchain/go-analysis-pins.nix"],
    executionMode: "branch",
  },
}
